# Telegram Bot — get token from @BotFather
TELEGRAM_BOT_TOKEN=

# Admin Telegram user IDs (comma-separated). Get yours from @userinfobot
ADMIN_IDS=

# Football data provider — get a free key at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# Optional: API-Football key (https://www.api-football.com/) — used for odds if present
API_FOOTBALL_KEY=

# Bookmaker odds — https://the-odds-api.com/ (free tier: 500 req/month)
# With this set, the bot emits VALUE signals (edge >= MIN_EDGE) instead of model-only.
ODDS_API_KEY=

# Optional: Anthropic API key for Claude-generated analytical commentaries on signals.
ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible LLM proxy (NeuroAPI, OpenRouter, etc.).
# If LLM_BASE_URL is set, the bot uses {LLM_BASE_URL}/chat/completions with
# Authorization: Bearer LLM_API_KEY instead of hitting Anthropic directly.
# Example for NeuroAPI:
#   LLM_BASE_URL=https://neuroapi.host/v1
#   LLM_API_KEY=your_neuroapi_key
#   LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Competitions to track (football-data.org codes). Defaults cover top-5 leagues + UCL.
COMPETITIONS=PL,PD,SA,BL1,FL1,CL,DED,PPL,ELC,BSA,CLI

# Database — Railway will inject DATABASE_URL automatically when you add Postgres.
# Falls back to local SQLite if unset.
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Value-bet thresholds
MIN_EDGE=0.05
MIN_CONFIDENCE=0.55
MIN_ODDS=1.80
MAX_ODDS=4.50

# Optional: Tavily web search API key for AI-ensemble web research.
# Free tier 1000 req/month — register at https://tavily.com
TAVILY_API_KEY=

# AI-ensemble: how much weight to give AI vs XGBoost (0..1). Default 0.3.
AI_ENSEMBLE_WEIGHT=0.3
# How many top-confident matches per cycle pass through AI. Default 10.
AI_ENSEMBLE_TOP_N=10
# Minimum max(1X2 prob) for a match to qualify for AI ensemble. Default 0.45.
AI_ENSEMBLE_MIN_PROB=0.45

# Scheduler timezone
TZ=Europe/Moscow
